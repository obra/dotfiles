#!/bin/sh
# dotfiles-audit — check the dotfiles repos for leaked secrets, deploy drift, and bad perms.
#
# Usage: dotfiles-audit [-q]
#   -q   quiet: print only findings + the summary line.
#
# Exit status: 0 = clean, 1 = one or more findings. Run it from anywhere; it locates the
# repo from its own path. See docs/AUDITING.md for the full ongoing-audit process.
set -eu

REPO_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
QUIET=0
[ "${1:-}" = "-q" ] && QUIET=1

findings=0
say()  { [ "$QUIET" = 1 ] || printf '%s\n' "$1"; }
flag() { printf '  ✗ %s\n' "$1"; findings=$((findings + 1)); }
ok()   { [ "$QUIET" = 1 ] || printf '  ✓ %s\n' "$1"; }

# perms as octal: Linux `stat -c`, macOS `stat -f`. Try -c first — on macOS it errors out
# (so we fall through), whereas Linux `stat -f` succeeds with *filesystem* info, not perms.
os_perm() { stat -c '%a' "$1" 2>/dev/null || stat -f '%A' "$1" 2>/dev/null; }
cur_os()  { case "$(uname -s)" in Darwin) echo macos;; Linux) echo linux;; *) echo other;; esac; }

say "== dotfiles audit =="
say "repo: $REPO_DIR"

# ---------------------------------------------------------------------------
say ""
say "[1] secret-pattern scan of tracked files"
# Literal credential shapes that must never be committed. docs/ and this script reference
# these patterns on purpose, so they are excluded from the scan.
PATTERNS='-----BEGIN [A-Z ]*PRIVATE KEY-----|ops_[A-Za-z0-9]{40,}|gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}|sk-[A-Za-z0-9]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}|AKIA[0-9A-Z]{16}'
for repo in "$REPO_DIR" "$REPO_DIR/../dotfiles-private"; do
  [ -d "$repo/.git" ] || continue
  name=$(basename "$repo")
  hits=$(git -C "$repo" grep -nIE "$PATTERNS" -- ':!docs/*' ':!bin/dotfiles-audit' 2>/dev/null || true)
  if [ -n "$hits" ]; then
    flag "[$name] possible secret(s) — investigate + ROTATE:"
    printf '%s\n' "$hits" | sed 's/^/      /'
  else
    ok "[$name] no known secret patterns in tracked files"
  fi
  # Filenames that usually hold secrets and should not be tracked at all.
  badnames=$(git -C "$repo" ls-files | grep -nE '(^|/)\.env|\.(pem|key|p12|pfx)$|credentials|\.crt$' || true)
  [ -n "$badnames" ] && flag "[$name] suspicious tracked filename(s): $(printf '%s' "$badnames" | tr '\n' ' ')"
done

# ---------------------------------------------------------------------------
say ""
say "[2] deploy drift — every manifest entry deployed for this OS?"
OS=$(cur_os)
for repo in "$REPO_DIR" "$REPO_DIR/../dotfiles-private"; do
  [ -f "$repo/manifest" ] || continue
  name=$(basename "$repo")
  miss=0
  # shellcheck disable=SC2162
  while IFS= read line || [ -n "$line" ]; do
    line=${line%%#*}
    set -f; set -- $line; set +f
    [ "$#" -eq 0 ] && continue
    rel=$1; tag=${2:-}
    [ -n "$tag" ] && [ "$tag" != "$OS" ] && continue
    src="$repo/$rel"; dest="$HOME/$rel"
    [ -e "$src" ] || { flag "[$name] manifest entry missing from repo: $rel"; miss=$((miss+1)); continue; }
    if [ -L "$dest" ] && [ "$dest" -ef "$src" ]; then :; else
      flag "[$name] not deployed (run install.sh): $rel"; miss=$((miss+1))
    fi
  done < "$repo/manifest"
  [ "$miss" = 0 ] && ok "[$name] all manifest entries deployed"
done

# ---------------------------------------------------------------------------
say ""
say "[3] permissions on local secret-bearing files"
checked=0
for f in "$HOME/.config/op/env"; do
  [ -e "$f" ] || continue
  checked=1
  p=$(os_perm "$f")
  [ "$p" = "600" ] && ok "$(printf %s "$f" | sed "s#$HOME#~#") is 600" || flag "$(printf %s "$f" | sed "s#$HOME#~#") is $p (want 600)"
done
[ "$checked" = 0 ] && ok "no local secret files present on this host"

# ---------------------------------------------------------------------------
say ""
if [ "$findings" -eq 0 ]; then
  printf 'PASS — no findings\n'
else
  printf 'FAIL — %s finding(s); review above\n' "$findings"
fi
[ "$findings" -eq 0 ]
