vscode/extensions
.DS_Store

# Never commit Claude Code credentials / local state to this PUBLIC repo
.claude/.credentials.json
.claude/.mcp.json
.claude/history.jsonl
.claude/local.md
.claude/cache/
.claude/debug/
.claude/projects/
.claude/todos/
.claude/statsig/

# --- secret/credential safety (defense-in-depth) ---
.env
.env.*
*.token
.netrc
.secrets
*.pem
*.key
*.p12
id_rsa
id_ed25519
id_ecdsa
# private shell fragments (sourced at runtime; never tracked in the PUBLIC repo)
.zshrc.private
private.zsh
.env.zsh
# fnox secret mapping lives in the PRIVATE repo only
.config/fnox/
fnox.toml
# machine-specific / tool-leaked artifacts (kept local, never published)
vscode/argv.json
bin/debug-mcp-wrapper.sh
*.log
# scratch trees that tasks have dumped into the repo working dir (never config)
artifacts/
node_modules/
__pycache__/
